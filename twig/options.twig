<div id="humanstxt" class="wrap">
    <h1>
        {{ __('Humans TXT', 'humanstxt') }}
    </h1>
    {# TODO: remove and build the FAQ in the plugin. #}
    <a href="http://wordpress.org/extend/plugins/humanstxt/faq/">
        {{ __('Please read the FAQ...' , 'humanstxt') }}
    </a>

    {% if settings_updated %}
    <div class="updated">
        <p>
            <strong>{{ _e( 'Settings saved.' ) }}</strong>
        </p>
    </div>
    {% elseif revision_restored %}
    <div class="updated">
        <p>
            <strong>{{ _e( 'Revision restored.', 'humanstxt' ) }}</strong>
        </p>
    </div>
    {% elseif file_imported %}
    <div class="updated">
        <p>
            <strong>{{ _e( 'Import successful. A backup of the original file has been created.', 'humanstxt' ) }}</strong>
        </p>
    </div>
    {% elseif rename_failed %}
    <div class="error">
        <p>
            <strong>{{ _e( 'Error: The content has been imported, but the original file could not be renamed.', 'humanstxt' ) }}</strong>
        </p>
    </div>
    {% elseif import_failed %}
    <div class="error">
        <p>
            <strong>{{ _e( 'Error: Import failed.', 'humanstxt' ) }}</strong>
        </p>
    </div>
    {% endif %}

    {% if humanstxt_exists and not rename_failed and not import_failed %}
    <div class="error">
        <p>
            <strong>{{ _e( 'Error: The site root already contains a physical humans.txt file.', 'humanstxt' ) }}</strong>
            
            {% if user_can_edit_files %}
            <span>{{ __( 'Please read the FAQ or try to', 'humanstxt') }}
                <a href="{{ import_file_url }}">{{ __('import and rename') }}</a>
                {{ __('the physical humans.txt file.', 'humanstxt' ) }}
            </span>
            {% endif %}
        </p>
    </div>
	{% elseif empty_permalink_structure and user_can_manage_options %}
    <div class="error">
        <p>
            <strong>
                {{ __( 'Error: Please', 'humanstxt' ) }}
                <a href="{{ permalink_structure_url }}">
                    update your permalink structure
                </a>
                {{ __( 'to something other than the default.', 'humanstxt' ) }}
            </strong>
        </p>
    </div>
    {% endif %}

    <form method="post" action="{{ humanstxt_options_url }}">
        {{ humanstxt_options_settings|raw }}

        {% if user_can_manage_options %}
        <h3>
            {{ _e( 'Settings' ) }}
        </h3>
        <table class="form-table">
            <tr valign="top">
                <th scope="row">
                    {{ _e( 'Humans TXT File', 'humanstxt' ) }}
                </th>
                <td>
                    <fieldset>
                        <legend class="screen-reader-text">
                            <span>
                                {{ _e( 'Humans TXT File', 'humanstxt' ) }}
                            </span>
                        </legend>
                        <input
                                id="humanstxt_enable"
                                name="humanstxt_enable"
                                type="checkbox"
                                value="1"
                                {% if humanstxt_enabled %}checked{% endif %}
                            >
                        <label for="humanstxt_enable">
                            {{ _e( 'Activate humans.txt file', 'humanstxt' ) }}
                        </label>
                        <br>
                        <input
                            id="humanstxt_author_tag"
                            name="humanstxt_author_tag"
                            type="checkbox"
                            value="1"
                            {% if humanstxt_author_tag %}checked{% endif %}
                        >
                        <label
                            for="humanstxt_author_tag"
                            title="{{ __('Adds a <link rel="author"> tag to the sites <head> tag pointing to the humans.txt file.', 'humanstxt' ) | esc_html}}"
                        >
                        {{ _e( 'Add an author link tag to the site', 'humanstxt' ) }}
                        </label>
                        
                    </fieldset>
                </td>
            </tr>
            <tr valign="top">
                <th scope="row">
                    {{ _e( 'Editing Permissions', 'humanstxt' ) }}
                </th>
                <td>
                    <fieldset>
                        <legend class="screen-reader-text">
                            <span>
                                {{ _e( 'Editing Permissions', 'humanstxt' ) }}
                            </span>
                        </legend>
                        <p>
                            {{ __('Roles that can edit the content of the humans.txt file:', 'humanstxt' ) }}
                        </p>
                        {% for role in roles %}
                            <label for="{{ role.id }}">
                                <input
                                    id="{{ role.id }}"	
                                    name="{{ role.name }}"
                                    type="checkbox"
                                    value="1"
                                    {{ role.checked }}
                                    {{ role.disabled }}
                                >
                                {{ role.friendly }}
                            </label>
                            <br>
                        {% endfor %}
                    </fieldset>
                </td>
            </tr>
        </table>

            <p class="submit clear">
                <input
                    type="submit"
                    name="submit"
                    class="button button-primary"
                    value="{{ _e( 'Save Changes' ) }}"
                >
                {% if humanstxt_enabled is not null %}
                    <a
                        href="{{ humanstxt_url }}"
                        rel="external"
                        class="button">
                        {{ _e( 'View Humans TXT', 'humanstxt' ) }}
                    >
                    </a>
                {% endif %}
            </p>
        {% endif %}
        <h3>{{ _e( 'Humans TXT File', 'humanstxt' ) }}</h3>

        <div id="humanstxt-editor-wrap">
            <table class="form-table">
                <tr valign="top">
                    <td>
                        <fieldset>
                            <legend class="screen-reader-text">
                                <span>{{ _e( 'Humans TXT File', 'humanstxt' ) }}</span>
                            </legend>
                            <span class="description">
                                <label for="humanstxt_content">
                                    {{ _e( 'If you need a little help with your humans.txt, try the "Help" button at the top right of this page.', 'humanstxt' ) }}
                                </label>
                            </span>
                            <textarea
                                id="humanstxt_content"
                                name="humanstxt_content"
                                rows="60"
                                cols="80"
                                class="large-text code"
                            >
                                {#- Trim at both ends to avoid unwanted identation. -#}
                                {{- humanstxt_content -}}
                            </textarea>
                        </fieldset>
                    </td>
                </tr>
            </table>
            <p class="submit">
                <input
                    type="submit"
                    name="submit"
                    class="button button-primary"
                    value="{{ _e( 'Save' ) }}"
                >
                <a
                    href="{{ humanstxt_preview_url }}"
                    class="button button-preview hide-if-no-js"
                    title="{{ _e( 'Preview' ) }}"
                >
                    {{ _e( 'Preview' ) }}
                </a>
                {% if have_revisions %}
                    <a
                        href="{{ revisions_url }}"
                        class="button"
                    >
                        {{ _e( 'View Revisions', 'humanstxt' ) }}
                    </a>
                {% endif %}
            </p>
        </div>

        {% if have_variables %}
            {% include 'variables.twig' %}
        {% endif %}
    </form>
</div>
